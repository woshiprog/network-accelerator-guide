---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign sitemap_pages = site.pages | sort: "url" %}
{% for p in sitemap_pages %}
  {% unless p.noindex or p.sitemap == false %}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>{% if p.last_modified_at %}
    <lastmod>{{ p.last_modified_at | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endunless %}
{% endfor %}
</urlset>
